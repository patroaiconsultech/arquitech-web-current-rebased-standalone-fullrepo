from dataclasses import replace

from fastapi.testclient import TestClient

from app.main import create_app
from tests.conftest import FakeOrkioAdapter


def test_open_registration_does_not_require_access_code(settings):
    open_settings = replace(
        settings,
        require_access_code=False,
        bootstrap_access_code=None,
        bootstrap_admin_email=None,
        bootstrap_admin_password=None,
    )
    app = create_app(settings=open_settings, orkio_adapter=FakeOrkioAdapter())

    with TestClient(app) as client:
        status = client.get("/api/access-grants/status?tenant=arquitech")
        assert status.status_code == 200
        assert status.json()["access_grant_required"] is False

        registered = client.post(
            "/api/auth/register",
            json={
                "tenant": "arquitech",
                "email": "open-registration@glip.example.com",
                "name": "Open Registration",
                "password": "Strong-Test-Password-7777",
                "accept_terms": True,
                "source": "glip",
                "product": "arquitech",
                "agent": "aria",
            },
            headers={"X-Org-Slug": "arquitech"},
        )
        assert registered.status_code == 201, registered.text

        logged_in = client.post(
            "/api/auth/login",
            json={
                "tenant": "arquitech",
                "email": "open-registration@glip.example.com",
                "password": "Strong-Test-Password-7777",
            },
            headers={"X-Org-Slug": "arquitech"},
        )
        assert logged_in.status_code == 200, logged_in.text
        assert logged_in.json()["tenant"] == "arquitech"


def test_open_registration_ignores_invalid_legacy_code(settings):
    open_settings = replace(
        settings,
        require_access_code=False,
        bootstrap_access_code=None,
    )
    app = create_app(settings=open_settings, orkio_adapter=FakeOrkioAdapter())

    with TestClient(app) as client:
        response = client.post(
            "/api/auth/register",
            json={
                "tenant": "arquitech",
                "email": "legacy-code@glip.example.com",
                "name": "Legacy Code",
                "password": "Strong-Test-Password-7777",
                "access_code": "INVALID-LEGACY-CODE",
                "accept_terms": True,
            },
            headers={"X-Org-Slug": "arquitech"},
        )
        assert response.status_code == 201, response.text
